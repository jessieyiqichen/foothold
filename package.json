{
  "name": "foothold",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @foothold/web --",
    "build": "npm run build -w @foothold/web",
    "lint": "npm run lint -w @foothold/web",
    "typecheck": "npm run typecheck -w @foothold/web",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e -w @foothold/web"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
